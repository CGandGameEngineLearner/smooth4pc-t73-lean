{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "T73_COMPLETE_GEOMETRY_BUNDLE_MANIFEST.schema.json",
  "title": "T73 complete selected-C geometry bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_file",
    "bundle_version",
    "bundle_status",
    "policy",
    "artifacts",
    "dependency_edges",
    "closed_facts",
    "first_open_gate",
    "manifest_payload_sha256"
  ],
  "properties": {
    "schema": {
      "const": "t73_complete_geometry_bundle_manifest/v1"
    },
    "schema_file": {
      "const": "data/T73_COMPLETE_GEOMETRY_BUNDLE_MANIFEST.schema.json"
    },
    "bundle_version": {
      "const": 1
    },
    "bundle_status": {
      "const": "OPEN"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_status_values",
        "fail_closed",
        "reconstruction_is_not_proof_completion",
        "open_cannot_be_promoted_without_new_checked_certificate_fields"
      ],
      "properties": {
        "allowed_status_values": {
          "const": ["VERIFIED", "OPEN"]
        },
        "fail_closed": {
          "const": true
        },
        "reconstruction_is_not_proof_completion": {
          "const": true
        },
        "open_cannot_be_promoted_without_new_checked_certificate_fields": {
          "const": true
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "dependency_edges": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "closed_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "saved_boundary_endpoint_count",
        "saved_source_exterior_interval_count",
        "target_template_arc_count",
        "wrong_side_active_interval_count"
      ],
      "properties": {
        "saved_boundary_endpoint_count": {"const": 1260},
        "saved_source_exterior_interval_count": {"const": 630},
        "target_template_arc_count": {"const": 630},
        "wrong_side_active_interval_count": {"const": 8}
      }
    },
    "first_open_gate": {
      "type": "string",
      "minLength": 1
    },
    "manifest_payload_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "status": {
      "enum": ["VERIFIED", "OPEN"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "schema",
        "generator",
        "verifier",
        "content_sha256",
        "content_bytes",
        "embedded_payload_sha256",
        "geometry_counts",
        "reconstruction_status",
        "completion_status",
        "status",
        "verification_diagnostic",
        "open_obligations"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "schema": {"type": "string", "minLength": 1},
        "generator": {"type": "string", "minLength": 1},
        "verifier": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "content_bytes": {"type": "integer", "minimum": 1},
        "embedded_payload_sha256": {"$ref": "#/$defs/nullableSha256"},
        "geometry_counts": {"type": "object"},
        "reconstruction_status": {"$ref": "#/$defs/status"},
        "completion_status": {"const": "OPEN"},
        "status": {"const": "OPEN"},
        "verification_diagnostic": {"type": "string", "minLength": 1},
        "open_obligations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind", "status"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"}
      }
    }
  }
}
