{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trace-73 primitive pivotal and grading input",
  "type": "object",
  "required": [
    "schema",
    "endpoint_duality_charts",
    "selected_cup_cap",
    "grading_diagrams"
  ],
  "properties": {
    "schema": {
      "const": "t73_c_pivotal_grading_input/v1"
    },
    "endpoint_duality_charts": {
      "type": "array",
      "minItems": 88,
      "maxItems": 88,
      "items": {
        "type": "object",
        "required": [
          "physical_endpoint_id",
          "tensor_position",
          "orientation",
          "boundary_face",
          "oriented_tangent_vector_at_boundary",
          "boundary_face_coorientation",
          "bpw_boundary_word_symbol",
          "variance",
          "variance_derivation",
          "nesting_parent_locator",
          "nesting_depth",
          "defect_basis_state",
          "duality_atoms",
          "highest_duality_atoms"
        ],
        "properties": {
          "physical_endpoint_id": {"type": "string"},
          "tensor_position": {"type": "integer", "minimum": 0, "maximum": 87},
          "orientation": {"enum": [-1, 1]},
          "boundary_face": {"enum": ["source", "target"]},
          "oriented_tangent_vector_at_boundary": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": ["integer", "number", "string"]}
          },
          "boundary_face_coorientation": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": ["integer", "number", "string"]}
          },
          "bpw_boundary_word_symbol": {"enum": ["up", "down"]},
          "variance": {"enum": ["V", "V_dual"]},
          "variance_derivation": {"type": "string", "minLength": 1},
          "nesting_parent_locator": {"type": "string", "minLength": 1},
          "nesting_depth": {"type": "integer", "minimum": 0},
          "defect_basis_state": {"enum": ["highest", "defect"]},
          "duality_atoms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "source_locator"],
              "properties": {
                "kind": {"type": "string"},
                "source_locator": {"type": "string"},
                "local_normal": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3
                }
              }
            }
          },
          "highest_duality_atoms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "source_locator"],
              "properties": {
                "kind": {"type": "string"},
                "source_locator": {"type": "string"},
                "local_normal": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3
                }
              }
            }
          }
        }
      }
    },
    "selected_cup_cap": {
      "type": "object",
      "required": ["cup", "cap"],
      "properties": {
        "cup": {"$ref": "#/$defs/orderedMorphism"},
        "cap": {"$ref": "#/$defs/orderedMorphism"}
      }
    },
    "grading_diagrams": {
      "type": "array",
      "items": {"$ref": "#/$defs/gradingDiagram"}
    }
  },
  "$defs": {
    "orderedMorphism": {
      "type": "object",
      "required": ["ordered_feet", "bpw_A6_term", "movie_or_web_locator", "terms"],
      "properties": {
        "ordered_feet": {"type": "array", "minItems": 2, "maxItems": 2},
        "bpw_A6_term": {"type": "string"},
        "movie_or_web_locator": {"type": "string"},
        "terms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["defect_endpoint_id", "atom"],
            "properties": {
              "defect_endpoint_id": {"type": "string"},
              "atom": {"type": "string"}
            }
          }
        }
      }
    },
    "gradingDiagram": {
      "type": "object",
      "required": ["name", "diagram_or_family_locator", "theory", "framing_convention"],
      "properties": {
        "name": {"type": "string"},
        "diagram_or_family_locator": {"type": "string"},
        "theory": {"type": "string"},
        "framing_convention": {"type": "string"},
        "conversion": {
          "type": "object",
          "required": ["blackboard_writhe", "formula", "applied_shift"],
          "properties": {
            "blackboard_writhe": {"type": "integer"},
            "formula": {"const": "-(N-1)*w"},
            "applied_shift": {"type": "integer"}
          }
        }
      }
    }
  }
}
