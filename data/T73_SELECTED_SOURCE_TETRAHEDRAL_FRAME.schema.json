{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "T73 selected-source tetrahedral frame or verified prefix",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "source_exterior_sha256",
    "scope",
    "actual_ar_relative_isotopy_proved",
    "tetgen",
    "tetgen_input_embedding",
    "plc_counts",
    "frame",
    "initial_source_binding",
    "verification",
    "sha256"
  ],
  "properties": {
    "schema": {"const": "t73_selected_source_tetrahedral_frame/v1"},
    "source_exterior_sha256": {"$ref": "#/$defs/sha256"},
    "scope": {
      "oneOf": [
        {"const": "complete"},
        {"type": "string", "pattern": "^prefix:[1-9][0-9]*$"}
      ]
    },
    "actual_ar_relative_isotopy_proved": {"const": false},
    "tetgen": {
      "type": "object",
      "required": ["python_wrapper_version"]
    },
    "tetgen_input_embedding": {"type": "object"},
    "plc_counts": {
      "type": "object",
      "required": ["vertices", "facets"]
    },
    "frame": {
      "type": "object",
      "required": ["complex", "boundary_components", "arcs", "ribbons"]
    },
    "initial_source_binding": {"type": "array", "minItems": 1, "maxItems": 630},
    "verification": {
      "type": "object",
      "required": [
        "verdict",
        "vertices",
        "tetrahedra",
        "boundary_components",
        "arcs",
        "ribbons",
        "exact_exterior_volume"
      ]
    },
    "sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    }
  }
}
